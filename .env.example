# =============================================================================
# OpenLens Snowflake Integration Configuration
# =============================================================================
# OpenLens is designed to run seamlessly 100% offline with zero remote dependencies.
# When Snowflake credentials are provided, OpenLens connects to Snowflake Cortex
# to retrieve curated architectural patterns and log aggregate product quality metrics.
#
# NOTE: Raw source code and secrets are NEVER transmitted to Snowflake.
# Copy this file to .env and fill in your connection details:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS / Linux)
# =============================================================================

# Enable or disable Snowflake integration (true / false)
OPENLENS_SNOWFLAKE_ENABLED=true

# Snowflake Account Identifier
# Format: <orgname>-<accountname> or <account_locator>.<region>.<cloud>
# Example: xy12345.us-east-1 or myorg-myaccount
SNOWFLAKE_ACCOUNT=your_account_identifier

# Snowflake Username
SNOWFLAKE_USER=OPENLENS_USER

# Authentication: Choose Password OR Private Key File
# Option A: Password Authentication (Recommended for local dev)
SNOWFLAKE_PASSWORD=your_local_dev_password

# Option B: Key-Pair Authentication (Recommended for production/CI)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8

# Snowflake Compute Warehouse
SNOWFLAKE_WAREHOUSE=OPENLENS_WH

# Target Database and Schema
SNOWFLAKE_DATABASE=OPENLENS_DB
SNOWFLAKE_SCHEMA=KNOWLEDGE

# Snowflake Role
SNOWFLAKE_ROLE=OPENLENS_ROLE

# Optional: OpenLens Backend Port (default: 8000)
# OPENLENS_API_PORT=8000
